# ── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Opcional pero recomendado: el servidor (cron / funciones) la usa para ignorar
# RLS. Nunca la pongas en el navegador ni en variables VITE_*.
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp (CallMeBot) ────────────────────────────────────────────────────
CALLMEBOT_API_KEY=

# ── SMTP ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASS=<app-password-de-16-caracteres>
EMAIL_FROM_NAME=Recordatorios

# ── Seguridad de los endpoints (opcionales) ─────────────────────────────────
# Si defines CRON_SECRET, /.netlify/functions/check-reminders exigirá
#   Authorization: Bearer <CRON_SECRET>
# Dejalo VACIO si usas el scheduler de netlify.toml: Netlify no envia esa
# cabecera, la funcion responderia 401 y los avisos no saldrian. Solo tiene
# sentido con un cron externo (cron-job.org, EasyCron...).
CRON_SECRET=

# Si defines CONFIRMATION_API_TOKEN, /api/send-confirmation aceptará además
# llamadas servidor-a-servidor con
#   Authorization: Bearer <CONFIRMATION_API_TOKEN>
CONFIRMATION_API_TOKEN=
